<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net10.0;netstandard2.1</TargetFrameworks>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <!-- RoguelikeToolkit.Dice ships unsigned (PublicKeyToken=null)
         and is outside our control, so referencing it from this signed assembly always
         raises CS8002. Suppressed deliberately to keep our strong-named identity; revisit if upstream signs. -->
    <NoWarn>$(NoWarn);CS8002</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\..\README.md">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </None>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="DefaultEcs" Version="0.17.2" />
    <PackageReference Include="deniszykov.TypeConversion" Version="3.2.4" />
    <PackageReference Include="Microsoft.Extensions.ObjectPool" Version="10.0.5" />
    <PackageReference Include="YamlDotNet" Version="18.1.0" />
    <PackageReference Include="RoguelikeToolkit.Dice" Version="1.0.4" />
    <PackageReference Include="Jint" Version="4.16.2" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Update="Microsoft.SourceLink.GitHub" Version="10.0.401" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Update="SIL.ReleaseTasks" Version="3.0.0" />
    <PackageReference Update="StyleCop.Analyzers.Unstable" Version="1.2.0.556" />
  </ItemGroup>

</Project>
