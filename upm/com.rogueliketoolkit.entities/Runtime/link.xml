<!--
  UnityLinker only reads link.xml files under Assets/; Editor/LinkXmlInjector.cs hands this one over during builds.
  Template loading and component conversion reach these assemblies by reflection only.
  Your own component types need the same protection: [Preserve] or a link.xml entry of your own.
-->
<linker>
  <assembly fullname="RoguelikeToolkit.Entities" preserve="all" />
  <assembly fullname="DefaultEcs" preserve="all" />
  <assembly fullname="YamlDotNet" preserve="all" />
</linker>
