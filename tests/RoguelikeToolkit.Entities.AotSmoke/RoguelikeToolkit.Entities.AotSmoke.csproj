<Project Sdk="Microsoft.NET.Sdk">

  <!--
    AOT smoke test: publishes with NativeAOT (no JIT, no Reflection.Emit, no runtime generic instantiation over
    value types) and runs load -> resolve -> spawn end to end. NativeAOT is stricter than Unity IL2CPP 2022.1+, so a
    pass here is a proxy for "runs on IL2CPP". Run: dotnet publish -c Release -r linux-x64 && ./bin/.../RoguelikeToolkit.Entities.AotSmoke
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <PublishAot>true</PublishAot>
    <InvariantGlobalization>true</InvariantGlobalization>
    <IsPackable>false</IsPackable>
    <SignAssembly>false</SignAssembly>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <!-- the equivalent of a Unity link.xml: component members are written through reflection -->
    <NoWarn>$(NoWarn);CS8002;SA1600;SA1649;SA1402;SA1201;SA1633</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <TrimmerRootAssembly Include="RoguelikeToolkit.Entities.AotSmoke" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\RoguelikeToolkit.Entities\RoguelikeToolkit.Entities.csproj" />
  </ItemGroup>

</Project>
